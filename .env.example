# Скопируйте в .env: Copy-Item .env.example .env
# Учебные креды: все сервисы доступны только локально.

# --- MinIO (S3 Data Lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Bucket, в котором лежат слои raw / staging / mart
S3_BUCKET=datalake

# --- ClickHouse (витрина) ---
CLICKHOUSE_USER=p1
CLICKHOUSE_PASSWORD=p1pass

# --- Postgres (метаданные Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow ---
# Общий секрет для подписи JWT между api-server и scheduler (любая длинная строка)
AIRFLOW_JWT_SECRET=change-me-p1-jwt-secret-0123456789
# Секрет веб-сессий api-server
AIRFLOW_API_SECRET_KEY=change-me-p1-api-secret-0123456789
